{
  "manifest_version": 3,
  "name": "MacIDM",
  "version": "0.6.0",
  "description": "Send downloads to the MacIDM download manager.",
  "key": "",
  "permissions": [
    "contextMenus",
    "downloads",
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
